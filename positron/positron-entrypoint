#!/bin/sh
# Точка входа образа с Positron.
#   без аргументов: подготовить SSH и запустить sshd (режим для Positron Remote SSH)
#   с аргументами:  выполнить команду (например, quarto render), sshd не запускается
set -e

if [ $# -gt 0 ]; then exec "$@"; fi

U=analyst
H="/home/$U"

# Ключ для входа передаётся при запуске: docker run -e SSH_PUBLIC_KEY="$(cat ~/.ssh/id_ed25519.pub)"
if [ -n "${SSH_PUBLIC_KEY:-}" ]; then
  install -d -m 700 -o "$U" -g "$U" "$H/.ssh"
  printf '%s\n' "$SSH_PUBLIC_KEY" > "$H/.ssh/authorized_keys"
  chown "$U:$U" "$H/.ssh/authorized_keys"
  chmod 600 "$H/.ssh/authorized_keys"
fi
[ -s "$H/.ssh/authorized_keys" ] || echo "positron-entrypoint: нет authorized_keys (задайте SSH_PUBLIC_KEY)" >&2

# Ключи хоста свои у каждого контейнера (в образе их нет)
ssh-keygen -A >/dev/null
mkdir -p /run/sshd
exec /usr/sbin/sshd -D -e
