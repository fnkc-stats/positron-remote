#!/bin/sh
# positron-projects: репозитории проекта в ~/work контейнера.
# Кладётся в образ как /usr/local/bin/positron-projects; run-positron.sh вызывает его по SSH
# с пробросом ssh-agent, так что git ходит в Gitea/GitHub с ключами пользователя и токены не нужны.
#
#   positron-projects sync <каталог> <url> [<запасной url>...]   добавить репозиторий и синхронизировать все
#   positron-projects sync                                       синхронизировать всё из списка
#   positron-projects status                                     незакоммиченное и неотправленное
#
# Список хранится в ~/work/.positron-projects: "<каталог> <url> [<url>...]".
# Клонирование пробует адреса по очереди (например, Gitea, затем зеркало на GitHub).
# Существующую работу скрипт не трогает: при незакоммиченных изменениях или расхождении
# с origin делается только fetch.
set -u

WORK_DIR="${WORK_DIR:-$HOME/work}"
LIST="$WORK_DIR/.positron-projects"
CMD="${1:-sync}"
[ $# -gt 0 ] && shift

say()  { printf '%s\n' "$*"; }
warn() { printf 'Внимание: %s\n' "$*" >&2; }

command -v git >/dev/null 2>&1 || { warn "в образе нет git"; exit 2; }
mkdir -p "$WORK_DIR" 2>/dev/null || { warn "нет прав на создание $WORK_DIR"; exit 2; }
# Ключи хостов Gitea/GitHub принимаются при первом подключении
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o StrictHostKeyChecking=accept-new -o BatchMode=yes}"
export GIT_TERMINAL_PROMPT=0

case "$CMD" in
  sync|status) ;;
  *) warn "неизвестная команда '$CMD' (sync или status)"; exit 2 ;;
esac

# Добавить / обновить запись в списке
if [ "$CMD" = sync ] && [ $# -gt 0 ]; then
  dir="$1"; shift
  [ $# -gt 0 ] || { warn "для '$dir' не указан url"; exit 2; }
  touch "$LIST"
  { grep -v "^$dir " "$LIST" || true; echo "$dir $*"; } > "$LIST.tmp" && mv "$LIST.tmp" "$LIST"
fi
[ -s "$LIST" ] || { say "Список проектов пуст, нечего делать."; exit 0; }

rc=0
while read -r dir urls <&3; do
  [ -n "$dir" ] || continue
  d="$WORK_DIR/$dir"

  if [ ! -e "$d" ]; then
    if [ "$CMD" = status ]; then say "[$dir] нет локальной копии"; continue; fi
    ok=""
    for url in $urls; do
      if git clone -q "$url" "$d" 2>/dev/null; then say "[$dir] склонирован из $url"; ok=1; break; fi
      warn "[$dir] $url недоступен"
    done
    [ -n "$ok" ] || { warn "[$dir] не удалось склонировать ни из одного адреса"; rc=1; }
    continue
  fi
  if ! git -C "$d" rev-parse --git-dir >/dev/null 2>&1; then
    warn "[$dir] $d существует, но это не git-репозиторий, пропускаю"; rc=1; continue
  fi

  if [ "$CMD" = sync ]; then
    git -C "$d" fetch -q --prune origin 2>/dev/null \
      || { warn "[$dir] origin ($(git -C "$d" remote get-url origin)) недоступен, работаю с тем, что есть"; rc=1; }
  fi

  dirty=""; [ -n "$(git -C "$d" status --porcelain)" ] && dirty=1
  if git -C "$d" rev-parse -q --verify '@{u}' >/dev/null 2>&1; then
    ahead="$(git -C "$d" rev-list --count '@{u}..HEAD')"
    behind="$(git -C "$d" rev-list --count 'HEAD..@{u}')"
  else
    ahead="?" behind=0
  fi

  if [ "$CMD" = sync ] && [ -z "$dirty" ] && [ "$behind" != 0 ]; then
    if git -C "$d" merge -q --ff-only '@{u}' 2>/dev/null; then say "[$dir] обновлён (+$behind)"; behind=0
    else warn "[$dir] ветка разошлась с origin, оставляю как есть"; fi
  fi

  state=""
  [ -n "$dirty" ] && state="$state незакоммиченные изменения;"
  [ "$ahead" = "?" ] && state="$state ветка без upstream;"
  [ "$ahead" != "?" ] && [ "$ahead" != 0 ] && state="$state не отправлено коммитов: $ahead;"
  [ "$behind" != 0 ] && state="$state отстаёт от origin на $behind;"
  if [ -n "$state" ]; then say "[$dir]$state"; else say "[$dir] актуален"; fi
done 3< "$LIST"

exit "$rc"
