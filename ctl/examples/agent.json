{
  "allowedImages": [
    "ghcr.io/fnkc-stats/r-env",
    "ghcr.io/fnkc-stats/r-base"
  ],
  "keysDir": "/etc/positron-ctl/keys",
  "limits": {
    "memory": "8g",
    "pids": 512,
    "cpus": "2"
  },
  "idleMinutes": 0,
  "sharedRenvCache": true,
  "rRepository": "https://cloud.r-project.org",
  "lockDir": "/var/lib/positron-ctl/locks",
  "maxProjectsPerUser": 2,
  "maxMemoryPerUser": "16g",
  "reserveMemory": "4g"
}
