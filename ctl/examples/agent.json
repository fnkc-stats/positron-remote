{
  "allowedImages": [
    "ghcr.io/fnkc-stats/r-env"
  ],
  "keysDir": "/etc/fnkc-ctl/keys",
  "requireProvenance": true,
  "provenanceRepository": "fnkc-stats/positron-remote",
  "provenanceWorkflow": ".github/workflows/positron.yml",
  "trustedRootFile": "/etc/fnkc-ctl/trusted-root.jsonl",
  "limits": {
    "memory": "8g",
    "pids": 512,
    "cpus": "2"
  },
  "idleMinutes": 0,
  "pullImages": false,
  "imageStagingDir": "/var/lib/fnkc-ctl/images",
  "lockDir": "/var/lib/fnkc-ctl/locks",
  "maxProjectsPerUser": 2,
  "maxMemoryPerUser": "16g",
  "reserveMemory": "4g",
  "imageReserve": "2g",
  "maxUnpackedImage": "64g",
  "maxImageStorage": "128g",
  "cranMirror": "https://mirror.truenetwork.ru/CRAN/"
}
