{
  "name": "positron-ctl",
  "version": "0.1.0",
  "private": true,
  "description": "Starts project containers for Positron on this computer or on a server",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "positron-ctl": "dist/positron-ctl.cjs"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node22 --format=cjs --loader:.sh=text --banner:js='#!/usr/bin/env node' --outfile=dist/positron-ctl.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
