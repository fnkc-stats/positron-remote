{
  "name": "positron-projects",
  "displayName": "Positron Projects",
  "description": "Opens projects in their own containers, on a server or on this computer",
  "version": "0.2.0",
  "publisher": "fnkc-stats",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18",
    "vscode": "^1.118.0"
  },
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.cjs",
  "bin": {
    "positron-ctl": "dist/positron-ctl.cjs"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "positronProjects.open",
        "title": "Open Project\u2026",
        "category": "Positron Projects",
        "icon": "$(add)"
      },
      {
        "command": "positronProjects.openUnlocked",
        "title": "Open Project with Decrypted Data\u2026",
        "category": "Positron Projects"
      },
      {
        "command": "positronProjects.stop",
        "title": "Stop Project\u2026",
        "category": "Positron Projects"
      },
      {
        "command": "positronProjects.showLog",
        "title": "Show Log",
        "category": "Positron Projects"
      },
      {
        "command": "positronProjects.setupWindows",
        "title": "Set Up Docker on This Computer (Windows, one time)",
        "category": "Positron Projects",
        "enablement": "isWindows"
      },
      {
        "command": "positronProjects.stopCurrent",
        "title": "Stop This Project and Close the Window",
        "category": "Positron Projects",
        "icon": "$(debug-stop)"
      },
      {
        "command": "positronProjects.refresh",
        "title": "Refresh",
        "category": "Positron Projects",
        "icon": "$(refresh)"
      },
      {
        "command": "positronProjects.openItem",
        "title": "Open",
        "category": "Positron Projects",
        "icon": "$(link-external)"
      },
      {
        "command": "positronProjects.openHere",
        "title": "Open Project Here\u2026",
        "category": "Positron Projects",
        "icon": "$(add)"
      },
      {
        "command": "positronProjects.stopItem",
        "title": "Stop",
        "category": "Positron Projects",
        "icon": "$(debug-stop)"
      },
      {
        "command": "positronProjects.checkSetup",
        "title": "Check Setup",
        "category": "Positron Projects",
        "icon": "$(checklist)"
      }
    ],
    "configuration": {
      "title": "Positron Projects",
      "properties": {
        "positronProjects.hosts": {
          "type": "array",
          "order": 1,
          "markdownDescription": "Approved container hosts. Automatic uses the first host only; choosing a different host is explicit. Stored in personal machine settings.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Short name, e.g. server or local"
              },
              "ssh": {
                "type": "string",
                "description": "user@host[:port]; leave out for this computer"
              }
            },
            "required": [
              "name"
            ]
          },
          "default": [],
          "scope": "machine"
        },
        "positronProjects.gitRemotes": {
          "type": "array",
          "order": 2,
          "items": {
            "type": "string"
          },
          "markdownDescription": "Where project repositories live, e.g. `ssh://git@gitea.example.lan:2221/stats`; `/<project>.git` is appended.",
          "default": [],
          "scope": "machine"
        },
        "positronProjects.sshKey": {
          "type": "string",
          "markdownDescription": "Private SSH key for logging in to containers. Empty: `~/.ssh/id_ed25519` (or id_ecdsa, id_rsa).",
          "default": "",
          "scope": "machine"
        },
        "positronProjects.localEngine": {
          "type": "string",
          "enum": [
            "auto",
            "colima",
            "docker-desktop",
            "wsl",
            "system"
          ],
          "enumDescriptions": [
            "Detect: Colima or Docker Desktop on macOS, Docker in WSL (positron) or Docker Desktop on Windows",
            "Colima (macOS)",
            "Docker Desktop",
            "Docker Engine in a WSL2 distribution (Windows, set up with windows/setup-wsl.ps1)",
            "The system's Docker service (Linux)"
          ],
          "markdownDescription": "Docker engine to start for local projects. The shared daemon is left running; stop it manually when appropriate.",
          "default": "auto",
          "scope": "machine"
        },
        "positronProjects.wslDistro": {
          "type": "string",
          "markdownDescription": "WSL distribution with Docker Engine (Windows).",
          "default": "positron",
          "scope": "machine"
        },
        "positronProjects.gitCryptKey": {
          "type": "string",
          "markdownDescription": "git-crypt key file, used by **Open Project with Decrypted Data**.",
          "default": "",
          "scope": "machine"
        },
        "positronProjects.idleMinutes": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "markdownDescription": "Automatic shutdown is off by default. If enabled, run unattended work with positron-projects run <command>. Server policy is configured by its administrator.",
          "scope": "machine"
        },
        "positronProjects.decryptionHosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "Host names explicitly approved for Open Project with Decrypted Data. Empty disables decryption."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "positronProjects.setupWindows",
          "when": "isWindows"
        },
        {
          "command": "positronProjects.openItem",
          "when": "false"
        },
        {
          "command": "positronProjects.openHere",
          "when": "false"
        },
        {
          "command": "positronProjects.stopItem",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "positronProjects.open",
          "when": "view == positronProjects.list",
          "group": "navigation@1"
        },
        {
          "command": "positronProjects.refresh",
          "when": "view == positronProjects.list",
          "group": "navigation@2"
        },
        {
          "command": "positronProjects.checkSetup",
          "when": "view == positronProjects.list",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "positronProjects.openItem",
          "when": "view == positronProjects.list && viewItem =~ /^project/",
          "group": "inline@1"
        },
        {
          "command": "positronProjects.stopItem",
          "when": "view == positronProjects.list && viewItem == project-running",
          "group": "inline@2"
        },
        {
          "command": "positronProjects.openHere",
          "when": "view == positronProjects.list && viewItem == host",
          "group": "inline@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "positronProjects",
          "title": "Positron Projects",
          "icon": "media/projects.svg"
        }
      ]
    },
    "views": {
      "positronProjects": [
        {
          "id": "positronProjects.list",
          "name": "Projects"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "positronProjects.list",
        "contents": "No hosts configured.\n[Open Project\u2026](command:positronProjects.open)"
      }
    ]
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:extension",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --target=node22 --format=cjs --loader:.sh=text --loader:.R=text --loader:.qmd=text --banner:js='#!/usr/bin/env node' --outfile=dist/positron-ctl.cjs",
    "build:extension": "esbuild src/extension.ts --bundle --platform=node --target=node22 --format=cjs --loader:.sh=text --loader:.R=text --loader:.qmd=text --external:vscode --outfile=dist/extension.cjs",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license -o dist/positron-projects.vsix",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/*.test.ts --bundle --platform=node --target=node22 --format=cjs --loader:.sh=text --loader:.R=text --loader:.qmd=text --outdir=.cache/tests --out-extension:.js=.cjs && node --test .cache/tests/*.test.cjs",
    "check": "npm run typecheck && npm test && npm run build",
    "server-bundle": "npm run build:cli && rm -rf dist/positron-ctl-server && mkdir -p dist/positron-ctl-server && cp dist/positron-ctl.cjs server/install.sh server/volume-backup.sh server/render-reviewed.py dist/positron-ctl-server/ && cp examples/agent.json dist/positron-ctl-server/agent.example.json && COPYFILE_DISABLE=1 tar --no-xattrs -czf dist/positron-ctl-server.tar.gz -C dist positron-ctl-server",
    "test:ssh": "npm run build:cli && python3 test/ssh-integration.py"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.118.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
