# Окружение проекта для run-positron.sh, CI и агентов. Кладётся в корень репозитория проекта.
#
# ENV_IMAGE — образ с R и пакетами, на котором работает проект. Всегда конкретный тег (не latest):
# так проект через год откроется с теми же версиями R и пакетов.
#   общий образ:          ghcr.io/<owner>/r-env:<тег>        (теги: GitHub → Packages → r-env)
#   свой образ проекта:   ghcr.io/<owner>/<проект>-env:<тег> (если есть Dockerfile, см. README)
# Обновление окружения = смена тега здесь отдельным коммитом.
ENV_IMAGE=ghcr.io/fnkc-stats/r-env:YYYY.MM.DD-abc1234
