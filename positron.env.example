# Скопируйте в positron.env и заполните. positron.env не коммитится.

# Реестр образов (GitHub Container Registry). Один раз: docker login ghcr.io -u <user>
# с PAT, у которого есть право read:packages (write:packages — чтобы пушить с этой машины).
REGISTRY="ghcr.io/OWNER"
# Образ окружения для проектов без container.env. Конкретный тег, не latest.
DEFAULT_ENV_IMAGE="ghcr.io/OWNER/r-env:YYYY.MM.DD-abc1234"

# Docker-хосты: имя=ssh://user@host[:port] или local (Docker на этой машине).
# Порядок важен: --host auto берёт первый доступный.
HOSTS="stats2=ssh://user@stats2 local"
# Хосты без доступа к ghcr.io: образ для них скачивается на этой машине и переносится (docker save | load)
NO_REGISTRY_HOSTS="stats2"
# Дополнительные параметры docker run для хоста: RUN_ARGS_<имя хоста>
# RUN_ARGS_stats2="--memory 64g --cpus 16"
# RUN_ARGS_local="--memory 8g"

# Архитектура образов: x64 или arm64. Локально на Apple Silicon x64 работает через эмуляцию
# (Docker Desktop: Settings → General → Use Rosetta; OrbStack — сразу). arm64 работает быстрее,
# но требует r-env, собранного и под linux/arm64 (env-image.yml, input platforms).
ARCH="x64"

# Адреса репозиториев проектов (база, к которой добавляется /<проект>.git), по очереди:
# если Gitea недоступна, клонируется с GitHub. Лучше SSH: тогда в контейнере работает
# ваш ssh-agent (Remote SSH с ForwardAgent), и токены нигде не хранятся.
GIT_REMOTES="git@gitea.example.lan:team git@github.com:OWNER"

# Публичный ключ для входа в контейнеры (по умолчанию ~/.ssh/id_ed25519.pub и т. п.)
# SSH_PUBLIC_KEY_FILE="$HOME/.ssh/id_ed25519.pub"

# Ключ git-crypt для --unlock (только для людей; агентам ключ не передаётся)
# GIT_CRYPT_KEY_FILE="$HOME/keys/project.git-crypt.key"

# Отправлять в реестр образы, собранные run-positron.sh на месте: 1/0
PUSH_BUILT=0
