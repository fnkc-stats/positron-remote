# Copy to positron.env and fill in. positron.env is not committed.

# Image registry (GitHub Container Registry). The public r-env image pulls without login; docker login ghcr.io
# is only needed to push from this machine and for private project images (see README).
REGISTRY="ghcr.io/fnkc-stats"
# Environment image for projects without container.env. A specific tag, not latest.
DEFAULT_ENV_IMAGE="ghcr.io/fnkc-stats/r-env:YYYY.MM.DD-abc1234"

# Docker hosts: name=ssh://user@host[:port] or local (Docker on this machine).
# Order matters: --host auto takes the first reachable one.
HOSTS="stats2=ssh://user@stats2 local"
# Hosts without access to ghcr.io: their images are pulled on this machine and copied (docker save | load)
NO_REGISTRY_HOSTS="stats2"
# Extra docker run options per host: RUN_ARGS_<host name>
# RUN_ARGS_stats2="--memory 64g --cpus 16"
# RUN_ARGS_local="--memory 8g"

# Image architecture: x64 or arm64. Locally on Apple Silicon x64 runs under emulation
# (Docker Desktop: Settings -> General -> Use Rosetta; Colima: --vz-rosetta; OrbStack: out of the box).
# arm64 is faster but needs r-env built for linux/arm64 too (env-image.yml, input platforms).
ARCH="x64"

# Where project repositories live: a base that /<project>.git is appended to (Gitea organization).
# Several bases are tried in order. SSH is preferred: then your ssh-agent works inside the container
# (Remote SSH with ForwardAgent) and no tokens are stored anywhere.
GIT_REMOTES="git@gitea.example.lan:stats"

# Public key for logging in to containers (default: ~/.ssh/id_ed25519.pub or similar)
# SSH_PUBLIC_KEY_FILE="$HOME/.ssh/id_ed25519.pub"

# git-crypt key for --unlock (people only; agents never get the key)
# GIT_CRYPT_KEY_FILE="$HOME/keys/project.git-crypt.key"

# Push images that run-positron.sh built on the spot to the registry: 1/0
PUSH_BUILT=0
